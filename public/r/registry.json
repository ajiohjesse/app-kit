      "title": "Global Modal Manager",
      "description": "Client-only LIFO modal stack with nested Dialog / Alert Dialog primitives, typed overlay settlement, and the Overlay Layer Registry.",
      "files": [
        {
          "path": "infra/modal-manager.ts",
          "type": "registry:lib",
          "target": "@lib/modal-manager.ts"
